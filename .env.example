# Telegram lead delivery — used by the /api/lead serverless function and the
# Vite dev middleware. Copy to `.env` and fill in real values.
#
# 1. Create a bot with @BotFather and copy the token it gives you.
# 2. Add the bot to the group/channel that should receive leads (or DM it).
# 3. Find the chat id (e.g. message @RawDataBot, or GET
#    https://api.telegram.org/bot<token>/getUpdates after sending the bot a message).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
